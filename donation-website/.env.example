# HelpHands Backend Base URL
# In local development: leave empty to default to http://localhost:5000, or set explicitly:
# VITE_API_BASE_URL=http://localhost:5000
#
# In production on Vercel: set VITE_API_BASE_URL to your deployed backend origin (e.g. https://your-backend.onrender.com)
# NOTE: Do NOT include trailing slash or /api, as individual endpoints automatically append /api/...
VITE_API_BASE_URL=
